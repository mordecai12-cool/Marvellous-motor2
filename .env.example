# Optional: local development generates a persistent secret in .local/session-key.
MM_SESSION_SECRET=
# Separate local database, leaving the repository's original database untouched.
MM_DB_PATH=.local/preview.db
# Local sharing: export MM_HOST=0.0.0.0 before starting the server.
# Other devices on the same Wi-Fi use http://<this-computers-LAN-IP>:8080.
# MM_HOST=127.0.0.1
# Set true only behind HTTPS. Local HTTP uses false.
MM_SECURE_COOKIES=false

# The local launch script enables fictional accounts; credentials stay in .local/.
MM_DEMO_MODE=true

# Production hosting: bind to the host's PORT and persist data on a mounted disk.
# MM_ENV=production
# MM_HOST=0.0.0.0
# PORT=10000
# MM_DATA_DIR=/var/data
# MM_DB_PATH=/var/data/marvellous.db
# MM_UPLOADS_DIR=/var/data/uploads
# MM_DEMO_MODE=false
# MM_SECURE_COOKIES=true
# MM_SESSION_SECRET=<generated secret with at least 32 bytes>
