# Optional: local development generates a persistent secret in .local/session-key.
MM_SESSION_SECRET=
# Separate local database, leaving the repository's original database untouched.
MM_DB_PATH=.local/preview.db
# Set true only behind HTTPS. Local HTTP uses false.
MM_SECURE_COOKIES=false

# The local launch script enables fictional accounts; credentials stay in .local/.
MM_DEMO_MODE=true
